# Disable execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh|bash)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Turn off PHP engine if mod_php is used
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
